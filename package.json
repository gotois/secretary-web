{
  "name": "tg",
  "version": "0.0.1",
  "description": "Global Virtual assistant: your personal all-in-one secretary. Telegram Bot Edition",
  "publisher": "GIC DAO",
  "homepage": "https://prosto-diary.gotointeractive.com",
  "type": "module",
  "main": "src/index.ts",
  "bin": "node ./src/index.ts --token=$TELEGRAM_TOKEN",
  "directories": {
    "src": "src",
    "docs": "docs"
  },
  "private": false,
  "files": [
    "bin",
    "src",
    "scripts"
  ],
  "targets": {
    "main": {
      "includeNodeModules": [],
      "context": "node",
      "outputFormat": "esmodule",
      "isLibrary": true,
      "optimize": true,
      "scopeHoist": true
    },
    "module": {
      "includeNodeModules": [],
      "outputFormat": "esmodule",
      "isLibrary": true,
      "optimize": true,
      "scopeHoist": true
    }
  },
  "imports": {
    "#env": "./src/app/config.ts",
    "#controllers/*": "./src/controllers/*.ts"
  },
  "scripts": {
    "commit": "git-cz",
    "publish": "echo 'Publishing is disabled' && exit 1",
    "pretest": "eslint . && npm run lint:dependency && npm run lint:markdown",
    "test": "mkdir -p reports && c8 --reports-dir=reports --reporter=lcov --reporter=text-summary --extension=.ts --all --src=src ava tests/unit",
    "dev": "node -r dotenv/config ./bin/server.ts --port=8888 --local",
    "dev:docs": "cd docs/ ; bundle exec jekyll serve",
    "clean": "npm-run-all clean:logs clean:test-cache",
    "clean:report": "rm -rf coverage reports",
    "clean:logs": "rm -rf logs/",
    "clean:test-cache": "ava reset-cache tests/e2e/index.ts --serial",
    "lint:dependency": "depcruise -x \"node_modules\" --validate .dependency-cruiser.mjs src tests",
    "lint:markdown": "markdownlint 'docs/**/*.md' --ignore 'docs/_site' --ignore 'docs/index.md'",
    "report:dependency": "mkdir -p reports && depcruise --include-only ^src --output-type dot src | dot -T svg > reports/dependencygraph.svg",
    "snyk-protect": "scripts/prepare.sh"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=26.x",
    "npm": ">=11.x"
  },
  "cpu": [
    "x64",
    "arm64"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gotois/secretary-tg.git"
  },
  "keywords": [
    "prostodiary",
    "prosto diary",
    "virtual assistant",
    "secretary",
    "personal telegram bot"
  ],
  "author": {
    "name": "Denis Baskovsky",
    "email": "baskovsky@ya.ru",
    "url": "https://baskovsky.ru/"
  },
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/gotois/secretary-tg/issues",
    "email": "support@gotointeractive.com"
  },
  "maintainers": [
    {
      "email": "denis@baskovsky.ru",
      "name": "Denis Baskovsky",
      "url": "https://baskovsky.ru/"
    }
  ],
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "@digitalbazaar/ed25519-signature-2020": "5.4.0",
    "@digitalbazaar/ed25519-verification-key-2020": "4.2.0",
    "@digitalbazaar/vc": "7.1.2",
    "@inrupt/solid-client": "3.0.0",
    "@inrupt/solid-client-authn-node": "5.0.0",
    "@inrupt/vocab-common-rdf": "1.0.5",
    "@langchain/openai": "1.3.1",
    "@photostructure/tz-lookup": "11.4.0",
    "cors": "2.8.6",
    "credentials-context": "2.0.0",
    "express": "5.2.1",
    "express-session": "1.19.0",
    "ffmpeg-static": "5.2.0",
    "file-type": "21.3.2",
    "fluent-ffmpeg": "2.1.3",
    "form-data": "4.0.5",
    "ical-browser": "0.2.2",
    "ical.js": "2.2.1",
    "jsonld-document-loader": "2.3.0",
    "jwt-decode": "4.0.0",
    "langchain-yandexgpt": "0.0.10",
    "minimist": "1.2.8",
    "minisearch": "7.1.1",
    "music-metadata": "7.14.0",
    "node-telegram-bot-api": "1.1.0",
    "openid-client": "6.8.4",
    "pdf-to-png-converter": "3.18.0",
    "request-json-rpc2": "2.3.1",
    "secretary-ai": "0.0.1",
    "telegram-bot-api-express": "1.4.5",
    "tsdav": "2.1.6",
    "uuid": "14.0.0",
    "zip-pack-unpack": "0.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "20.5.3",
    "@eslint/eslintrc": "3.3.5",
    "@ngrok/ngrok": "1.4.1",
    "@types/express": "5.0.3",
    "@types/express-session": "1.18.1",
    "@types/minimist": "1.2.5",
    "@types/node": "22.15.21",
    "@typescript-eslint/eslint-plugin": "8.61.0",
    "@typescript-eslint/parser": "8.61.0",
    "ava": "6.4.1",
    "c8": "7.14.0",
    "codecov": "4.0.0-0",
    "commitizen": "4.3.1",
    "cz-conventional-changelog": "3.3.0",
    "dependency-cruiser": "18.0.0",
    "dotenv": "17.3.1",
    "eslint": "9.39.3",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-ava": "15.1.0",
    "eslint-plugin-jsdoc": "62.9.0",
    "eslint-plugin-prettier": "5.5.5",
    "eslint-plugin-unicorn": "64.0.0",
    "husky": "3.1.0",
    "lint-staged": "11.2.6",
    "markdownlint-cli": "0.49.0",
    "npm-check-updates": "17.1.11",
    "npm-run-all": "4.1.5",
    "prettier": "3.8.1",
    "snyk": "1.1295.1",
    "validator": "13.12.0"
  },
  "snyk": false
}
